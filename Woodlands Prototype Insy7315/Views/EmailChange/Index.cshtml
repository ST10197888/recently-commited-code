@model Woodlands_Prototype_Insy7315.Models.EmailChangeRequestViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Email Change Request";
    ViewData["Subtitle"] = "Review a change to your sign-in email address.";
}

<div class="max-w-2xl mx-auto">
    @if (Model == null)
    {
        <div class="bg-white rounded-xl border border-line shadow-sm p-10 text-center text-sm text-muted">
            You have no email change request.
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl border border-line shadow-sm p-6 lg:p-8 space-y-5">
            <div class="grid sm:grid-cols-2 gap-5">
                <div>
                    <div class="text-[0.65rem] uppercase tracking-wider text-muted font-semibold">Current email</div>
                    <div class="mt-1 text-sm text-ink break-all">@Model.CurrentEmail</div>
                </div>
                <div>
                    <div class="text-[0.65rem] uppercase tracking-wider text-muted font-semibold">New email</div>
                    <div class="mt-1 text-sm font-semibold text-brand-700 break-all">@(string.IsNullOrWhiteSpace(Model.NewEmail) ? "Not provided" : Model.NewEmail)</div>
                </div>
            </div>

            <div class="text-sm text-ink">
                <span class="text-muted">Status:</span> @Model.Status
                @if (Model.CreatedAt != null)
                {
                    <span class="text-muted"> · requested @Model.CreatedAt.Value.ToString("dd MMM yyyy")</span>
                }
            </div>

            @if (Model.IsPending)
            {
                <div class="bg-brand-700/5 border border-brand-700/15 text-brand-700 rounded-lg p-4 text-xs leading-relaxed">
                    If you accept, your sign-in email changes and you will be asked to sign in again with the new address.
                </div>

                <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-line">
                    <form asp-action="Decide" method="post"
                          data-confirm="Change your sign-in email to @Model.NewEmail?"
                          data-confirm-title="Accept email change"
                          data-confirm-ok="Accept">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="accept" value="true" />
                        <button type="submit" class="px-5 py-2.5 rounded-lg bg-brand-700 text-white font-semibold hover:bg-brand-800">Accept change</button>
                    </form>

                    <form asp-action="Decide" method="post"
                          data-confirm="Reject this change? Your email address stays as it is."
                          data-confirm-title="Reject email change"
                          data-confirm-ok="Reject">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="accept" value="false" />
                        <button type="submit" class="px-5 py-2.5 rounded-lg border border-line font-semibold text-ink hover:bg-surface">Reject</button>
                    </form>
                </div>
            }
        </div>
    }
</div>
