@model IEnumerable<Woodlands_Prototype_Insy7315.Models.Branch>

@{
    ViewData["Title"] = "Our Branches";
}

<div class="max-w-6xl mx-auto px-4 py-10">

    <div class="mb-8">
        <p class="text-xs uppercase tracking-[0.18em] text-accent font-semibold">
            Find Us
        </p>

        <h1 class="font-display text-4xl text-brand-700 mt-2">
            Our Branches
        </h1>

        <p class="text-muted mt-2 max-w-2xl">
            Visit your nearest Woodlands Designer Boards branch for advice,
            materials, cutting and project support.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="rounded-xl border border-line bg-white p-6 text-muted">
            Branch information is currently unavailable.
        </div>
    }
    else
    {
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

            @foreach (var branch in Model)
            {
                <article class="bg-white rounded-xl border border-line overflow-hidden shadow-sm">

                    @{
                        var fallbackImage = branch.Name switch
                        {
                            "Soweto" => "/images/products/Kitchen Unit 12.jpeg",
                            "Roodepoort" => "/images/products/Kitchen Unit 6.jpeg",
                            "Randfontein" => "/images/products/Kitchen Unit 3.jpeg",
                            _ => ""
                        };
                    }

                    @if (!string.IsNullOrWhiteSpace(branch.Image))
                    {
                        <div class="h-52 overflow-hidden bg-surface">
                            <img src="@branch.Image"
                                 alt="@branch.Name Branch"
                                 class="w-full h-full object-cover"
                                 loading="lazy"
                                 onerror="this.onerror=null; this.src='@fallbackImage';" />
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(fallbackImage))
                    {
                        <div class="h-52 overflow-hidden bg-surface">
                            <img src="@fallbackImage"
                                 alt="@branch.Name Branch"
                                 class="w-full h-full object-cover"
                                 loading="lazy" />
                        </div>
                    }
                    else
                    {
                        <div class="h-52 bg-brand-700 flex items-center justify-center">
                            <span class="font-display text-3xl text-white">
                                @branch.Name
                            </span>
                        </div>
                    }

                    <div class="p-6">

                        <h2 class="font-display text-2xl text-brand-700">
                            @branch.Name Branch
                        </h2>

                        <p class="text-sm text-muted mt-1">
                            @branch.Region
                        </p>

                        @if (!string.IsNullOrWhiteSpace(branch.Address))
                        {
                            <div class="mt-5">
                                <p class="text-xs uppercase tracking-wider text-muted font-semibold">
                                    Address
                                </p>
                                <p class="text-sm text-ink mt-1">
                                    @branch.Address
                                </p>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(branch.Phone))
                        {
                            <div class="mt-4">
                                <p class="text-xs uppercase tracking-wider text-muted font-semibold">
                                    Phone
                                </p>
                                <p class="text-sm text-ink mt-1">
                                    @branch.Phone
                                </p>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(branch.Hours))
                        {
                            <div class="mt-4">
                                <p class="text-xs uppercase tracking-wider text-muted font-semibold">
                                    Opening Hours
                                </p>
                                <p class="text-sm text-ink mt-1">
                                    @branch.Hours
                                </p>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(branch.Notes))
                        {
                            <div class="mt-4">
                                <p class="text-sm text-muted">
                                    @branch.Notes
                                </p>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(branch.Address))
                        {
                            <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(branch.Address)"
                               target="_blank"
                               rel="noopener"
                               class="inline-flex items-center justify-center w-full mt-6 px-4 py-2.5 rounded-lg bg-brand-700 text-white font-semibold hover:bg-brand-800 transition">
                                Open in Maps
                            </a>
                        }

                    </div>
                </article>
            }

        </div>
    }
</div>