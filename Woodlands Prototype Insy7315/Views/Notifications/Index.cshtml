@model Woodlands_Prototype_Insy7315.Models.NotificationListViewModel

@{
    ViewData["Title"] = "Notifications";
    Layout = "_AdminLayout";

    var unreadNotifications = Model.Notifications
        .Where(n => !n.IsRead)
        .ToList();

    var readNotifications = Model.Notifications
        .Where(n => n.IsRead)
        .ToList();
}

<div class="mx-auto max-w-6xl space-y-6">

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-amber-700">
                Your account
            </p>
            <h1 class="mt-1 text-3xl font-bold text-stone-900">
                Notifications
            </h1>
            <p class="mt-2 text-sm text-stone-500">
                Stay up to date with activity and updates relating to your account.
            </p>
        </div>

        @if (Model.Notifications.Any(n => !n.IsRead))
        {
            <form asp-controller="Notifications"
                  asp-action="MarkAllRead"
                  method="post">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="rounded-lg border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-700 transition hover:bg-stone-100">
                    Mark all as read
                </button>
            </form>
        }
    </div>

    @if (TempData["NotificationMessage"] != null)
    {
        <div class="rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
            @TempData["NotificationMessage"]
        </div>
    }

    @if (TempData["NotificationError"] != null)
    {
        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
            @TempData["NotificationError"]
        </div>
    }

    @if (!Model.IsAvailable)
    {
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-6">
            <h2 class="font-semibold text-amber-900">
                Notifications temporarily unavailable
            </h2>
            <p class="mt-2 text-sm text-amber-800">
                We couldn't retrieve your notifications right now.
                Please try again shortly.
            </p>
            <a asp-controller="Notifications"
               asp-action="Index"
               class="mt-4 inline-block text-sm font-semibold text-amber-900 underline">
                Try again
            </a>
        </div>
    }
    else if (!Model.Notifications.Any())
    {
        <div class="rounded-xl border border-stone-200 bg-white px-6 py-16 text-center shadow-sm">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-stone-100">
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="h-7 w-7 text-stone-500"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor"
                     stroke-width="1.7">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 00-4.5-5.8V4a1.5 1.5 0 00-3 0v1.2A6 6 0 006 11v3.2a2 2 0 01-.6 1.4L4 17h5m6 0v1a3 3 0 01-6 0v-1m6 0H9" />
                </svg>
            </div>

            <h2 class="mt-4 text-lg font-semibold text-stone-900">
                You're all caught up
            </h2>
            <p class="mt-2 text-sm text-stone-500">
                New notifications will appear here when there's something to share.
            </p>
        </div>
    }
    else
    {
        @if (unreadNotifications.Any())
        {
            <section class="space-y-3">
                <div class="flex items-center justify-between">
                    <h2 class="text-lg font-semibold text-stone-900">
                        Unread
                    </h2>
                    <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">
                        @Model.UnreadCount unread
                    </span>
                </div>

                @foreach (var notification in unreadNotifications)
                {
                    <article class="rounded-xl border border-amber-200 bg-amber-50/50 p-5 shadow-sm">
                        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center gap-2">
                                    <h3 class="font-semibold text-stone-900">
                                        @notification.Title
                                    </h3>
                                    <span class="rounded-full bg-amber-100 px-2 py-1 text-xs font-medium text-amber-800">
                                        New
                                    </span>
                                    @if (notification.ActionRequired)
                                    {
                                        <span class="rounded-full bg-blue-100 px-2 py-1 text-xs font-medium text-blue-800">
                                            Action required
                                        </span>
                                    }
                                </div>

                                <p class="mt-2 whitespace-pre-line text-sm leading-6 text-stone-600">
                                    @notification.Message
                                </p>

                                <p class="mt-3 text-xs text-stone-400">
                                    @notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                </p>

                                @if (notification.ActionRequired)
                                {
                                    <p class="mt-2 text-xs font-medium text-blue-700">
                                        Status: @notification.ActionStatus
                                    </p>
                                }
                            </div>

                            <div class="flex shrink-0 flex-wrap gap-2">
                                <form asp-controller="Notifications"
                                      asp-action="MarkRead"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@notification.Id" />
                                    <button type="submit"
                                            class="rounded-lg bg-stone-900 px-3 py-2 text-xs font-semibold text-white transition hover:bg-stone-700">
                                        Mark as read
                                    </button>
                                </form>

                                <form asp-controller="Notifications"
                                      asp-action="Dismiss"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@notification.Id" />
                                    <button type="submit"
                                            class="rounded-lg border border-stone-300 px-3 py-2 text-xs font-semibold text-stone-600 transition hover:bg-white">
                                        Dismiss
                                    </button>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </section>
        }

        @if (readNotifications.Any())
        {
            <section class="space-y-3">
                <h2 class="text-lg font-semibold text-stone-900">
                    Earlier notifications
                </h2>

                @foreach (var notification in readNotifications)
                {
                    <article class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
                        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center gap-2">
                                    <h3 class="font-semibold text-stone-800">
                                        @notification.Title
                                    </h3>

                                    @if (notification.ActionRequired)
                                    {   
                                        <span class="rounded-full bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700">
                                            @notification.ActionStatus
                                        </span>
                                    }
                                </div>

                                <p class="mt-2 whitespace-pre-line text-sm leading-6 text-stone-500">
                                    @notification.Message
                                </p>

                                <p class="mt-3 text-xs text-stone-400">
                                    @notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                </p>
                            </div>

                            <form asp-controller="Notifications"
                                  asp-action="Dismiss"
                                  method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@notification.Id" />
                                <button type="submit"
                                        class="rounded-lg border border-stone-300 px-3 py-2 text-xs font-semibold text-stone-600 transition hover:bg-stone-50">
                                    Dismiss
                                </button>
                            </form>
                        </div>
                    </article>
                }
            </section>
        }
    }
</div>
