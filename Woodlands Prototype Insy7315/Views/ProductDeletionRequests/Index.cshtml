@model List<Woodlands_Prototype_Insy7315.Models.ProductDeletionRequestViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Product Deletion Requests";
    ViewData["Subtitle"] = User.IsInRole("Admin")
        ? "Approve or reject requests to remove products."
        : "Track the product deletion requests you have sent for approval.";

    var filter = ViewData["Filter"]?.ToString() ?? "pending";
    var isAdmin = User.IsInRole("Admin");

    string Badge(string status) => status.ToLowerInvariant() switch
    {
        "approved" => "bg-success/10 text-success",
        "rejected" => "bg-danger/10 text-danger",
        "cancelled" => "bg-surface text-muted",
        _ => "bg-accent/10 text-accent"
    };
}

<div class="flex gap-2 mb-5">
    <a asp-action="Index" asp-route-filter="pending"
       class="px-4 py-2 rounded-lg text-sm font-semibold @(filter == "pending" ? "bg-brand-700 text-white" : "border border-line bg-white text-ink hover:bg-surface")">
        Pending
    </a>
    <a asp-action="Index" asp-route-filter="all"
       class="px-4 py-2 rounded-lg text-sm font-semibold @(filter == "all" ? "bg-brand-700 text-white" : "border border-line bg-white text-ink hover:bg-surface")">
        All requests
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="bg-white rounded-xl border border-line shadow-sm p-10 text-center text-sm text-muted">
        @(filter == "pending" ? "No pending product deletion requests." : "No product deletion requests yet.")
    </div>
}
else
{
    <div class="space-y-4">
        @foreach (var r in Model)
        {
            <div class="bg-white rounded-xl border border-line shadow-sm p-5">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <div class="font-semibold text-ink">@r.ProductTitle</div>
                        <div class="text-xs text-muted mt-1">
                            @(r.CreatedAt?.ToString("dd MMM yyyy, HH:mm") ?? "")
                            @if (!string.IsNullOrWhiteSpace(r.RequestedBy))
                            {
                                <text> · requested by @r.RequestedBy</text>
                            }
                        </div>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold @Badge(r.Status)">@r.Status</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(r.Reason))
                {
                    <p class="text-sm text-ink mt-3"><span class="text-muted">Reason:</span> @r.Reason</p>
                }

                @if (!string.IsNullOrWhiteSpace(r.AdminNote))
                {
                    <p class="text-sm text-ink mt-2"><span class="text-muted">Admin note:</span> @r.AdminNote</p>
                }

                @if (isAdmin && r.IsPending)
                {
                    <div class="flex flex-col sm:flex-row gap-3 mt-4 pt-4 border-t border-line">
                        <form asp-action="Approve" asp-route-id="@r.Id" method="post"
                              data-confirm="Delete &quot;@r.ProductTitle&quot; permanently?"
                              data-confirm-title="Approve deletion"
                              data-confirm-ok="Delete product">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="px-4 py-2 rounded-lg bg-danger text-white text-sm font-semibold hover:opacity-90">
                                Approve and delete
                            </button>
                        </form>

                        <form asp-action="Reject" asp-route-id="@r.Id" method="post" class="flex flex-1 gap-2">
                            @Html.AntiForgeryToken()
                            <input name="note" maxlength="500" placeholder="Reason for rejecting (optional)"
                                   class="flex-1 rounded-lg border border-line px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-700/20 focus:border-brand-700" />
                            <button type="submit" class="px-4 py-2 rounded-lg border border-line text-sm font-semibold text-ink hover:bg-surface">
                                Reject
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
}
