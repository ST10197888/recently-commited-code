@model IEnumerable<Woodlands_Prototype_Insy7315.Models.Testimonial>
@{
    ViewData["Title"] = "Testimonials";
    ViewData["Subtitle"] = "Customer reviews shown on the public site.";
    ViewData["HeaderAction"] = @"<a href=""/Admin/CreateTestimonial"" class=""inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-brand-700 text-white text-sm font-semibold hover:bg-brand-800"">
        <svg width=""16"" height=""16"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2.5"" stroke-linecap=""round""><path d=""M12 5v14M5 12h14""/></svg>
        New testimonial
    </a>";

    var allTestimonials = Model.ToList();
    var currentFilter = ViewData["Filter"] as string ?? "all";

    var testimonials = currentFilter switch
    {
        "5" => allTestimonials.Where(t => t.Rating == 5).ToList(),
        "4" => allTestimonials.Where(t => t.Rating == 4).ToList(),
        "3" => allTestimonials.Where(t => t.Rating == 3).ToList(),
        _ => allTestimonials
    };

    var fiveCount = allTestimonials.Count(t => t.Rating == 5);
    var fourCount = allTestimonials.Count(t => t.Rating == 4);
    var threeCount = allTestimonials.Count(t => t.Rating <= 3);
}

<div class="bg-white rounded-xl border border-line shadow-sm">

    <!-- Toolbar -->
    <div class="p-4 border-b border-line flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">

        <div class="relative flex-1 max-w-md">
            <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            <input type="text" id="testimonial-search" placeholder="Search by customer name or project..."
                   class="w-full rounded-lg border border-line pl-9 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-700/20 focus:border-brand-700" />
        </div>

        <div class="flex items-center gap-1.5">
            <a asp-action="Testimonials" asp-route-filter="all"
               class="px-3 py-1.5 rounded-full text-xs font-medium border transition-colors @(currentFilter == "all" ? "bg-brand-700 text-white border-brand-700" : "bg-white text-ink/70 border-line hover:border-brand-700/40")">
                All (@allTestimonials.Count)
            </a>
            <a asp-action="Testimonials" asp-route-filter="5"
               class="px-3 py-1.5 rounded-full text-xs font-medium border transition-colors @(currentFilter == "5" ? "bg-brand-700 text-white border-brand-700" : "bg-white text-ink/70 border-line hover:border-brand-700/40")">
                5 stars (@fiveCount)
            </a>
            <a asp-action="Testimonials" asp-route-filter="4"
               class="px-3 py-1.5 rounded-full text-xs font-medium border transition-colors @(currentFilter == "4" ? "bg-brand-700 text-white border-brand-700" : "bg-white text-ink/70 border-line hover:border-brand-700/40")">
                4 stars (@fourCount)
            </a>
            <a asp-action="Testimonials" asp-route-filter="3"
               class="px-3 py-1.5 rounded-full text-xs font-medium border transition-colors @(currentFilter == "3" ? "bg-brand-700 text-white border-brand-700" : "bg-white text-ink/70 border-line hover:border-brand-700/40")">
                3 or less (@threeCount)
            </a>
        </div>
    </div>

    @if (!testimonials.Any())
    {
        <div class="py-16 text-center">
            <svg class="w-12 h-12 mx-auto text-muted/50 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
            <h3 class="text-base font-semibold text-ink">No testimonials here</h3>
            <p class="text-sm text-muted mt-1">Add your first customer review to get started.</p>
            <a href="/Admin/CreateTestimonial"
               class="inline-flex items-center gap-2 mt-5 px-4 py-2 rounded-lg bg-brand-700 text-white text-sm font-semibold hover:bg-brand-800">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                Add testimonial
            </a>
        </div>
    }
    else
    {
        <!-- Table (desktop) -->
        <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-surface text-muted text-xs uppercase tracking-wide">
                    <tr>
                        <th class="text-left font-medium px-4 py-3">Customer</th>
                        <th class="text-left font-medium px-4 py-3">Review</th>
                        <th class="text-left font-medium px-4 py-3 w-24">Rating</th>
                        <th class="text-right font-medium px-4 py-3 w-32">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line">
                    @foreach (var t in testimonials)
                    {
                        <tr class="hover:bg-surface/60 transition-colors testimonial-row"
                            data-search="@($"{t.Name} {t.Project} {t.Location}".ToLower())">
                            <td class="px-4 py-3">
                                <div class="font-medium text-ink leading-tight">@t.Name</div>
                                <div class="text-xs text-muted">@t.Role@(!string.IsNullOrEmpty(t.Location) ? $" · {t.Location}" : "")</div>
                            </td>
                            <td class="px-4 py-3">
                                <div class="text-xs text-muted truncate max-w-md">@t.Review</div>
                                <div class="text-[0.7rem] text-muted/70 mt-0.5">@t.Project</div>
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-0.5">
                                    @for (int i = 0; i < t.Rating; i++)
                                    {
                                        <span class="text-accent text-sm">&#9733;</span>
                                    }
                                    @for (int i = t.Rating; i < 5; i++)
                                    {
                                        <span class="text-line text-sm">&#9733;</span>
                                    }
                                </div>
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex items-center justify-end gap-1">
                                    <a asp-action="EditTestimonial" asp-route-id="@t.Id"
                                       class="p-2 rounded-lg text-muted hover:bg-surface hover:text-brand-700" title="Edit">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                    </a>
                                    <form asp-action="DeleteTestimonial" asp-route-id="@t.Id" method="post" class="inline"
                                          data-confirm="Delete &quot;@t.Name&quot;'s testimonial? This action cannot be undone."
                                          data-confirm-title="Delete testimonial"
                                          data-confirm-ok="Delete">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="p-2 rounded-lg text-muted hover:bg-danger/10 hover:text-danger" title="Delete">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile cards -->
        <div class="md:hidden divide-y divide-line">
            @foreach (var t in testimonials)
            {
                <div class="p-4">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <div class="font-medium text-ink">@t.Name</div>
                            <div class="text-xs text-muted">@t.Role · @t.Location</div>
                        </div>
                        <div class="shrink-0">
                            @for (int i = 0; i < t.Rating; i++)
                            {
                                <span class="text-accent text-xs">&#9733;</span>
                            }
                        </div>
                    </div>
                    <p class="text-xs text-muted mt-2 line-clamp-3">@t.Review</p>
                    <div class="flex gap-1 mt-3">
                        <a asp-action="EditTestimonial" asp-route-id="@t.Id"
                           class="px-3 py-1 rounded-md text-xs font-medium border border-line hover:bg-surface">Edit</a>
                        <form asp-action="DeleteTestimonial" asp-route-id="@t.Id" method="post"
                              data-confirm="Delete &quot;@t.Name&quot;'s testimonial?"
                              data-confirm-title="Delete testimonial">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="px-3 py-1 rounded-md text-xs font-medium border border-danger/30 text-danger hover:bg-danger/5">Delete</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('testimonial-search');
            if (!input) return;
            var rows = document.querySelectorAll('.testimonial-row');

            input.addEventListener('input', function () {
                var q = this.value.trim().toLowerCase();
                rows.forEach(function (row) {
                    var haystack = row.dataset.search || '';
                    row.style.display = !q || haystack.indexOf(q) !== -1 ? '' : 'none';
                });
            });
        })();
    </script>
}