@model IEnumerable<Woodlands_Prototype_Insy7315.Controllers.AdminUserRowViewModel>
@{
    ViewData["Title"] = "Users";
    ViewData["Subtitle"] = "Manage user accounts and roles.";
    ViewData["HeaderAction"] = @"<a href=""/Admin/CreateUser"" class=""inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-brand-700 text-white text-sm font-semibold hover:bg-brand-800"">
        <svg width=""16"" height=""16"" viewBox=""0 0 24 24"" fill=""none"" stroke=""currentColor"" stroke-width=""2.5"" stroke-linecap=""round""><path d=""M12 5v14M5 12h14""/></svg>
        New user
    </a>";

    var allUsers = Model.ToList();
    var currentFilter = ViewData["Filter"] as string ?? "all";

    var users = currentFilter switch
    {
        "admin" => allUsers.Where(u => u.Role == "Admin").ToList(),
        "managers" => allUsers.Where(u => u.Role.StartsWith("Manager")).ToList(),
        "customers" => allUsers.Where(u => u.Role == "Customer").ToList(),
        "inactive" => allUsers.Where(u => !u.Active).ToList(),
        _ => allUsers
    };

    var adminCount = allUsers.Count(u => u.Role == "Admin");
    var managerCount = allUsers.Count(u => u.Role.StartsWith("Manager"));
    var customerCount = allUsers.Count(u => u.Role == "Customer");
    var inactiveCount = allUsers.Count(u => !u.Active);
}

<div class="bg-white rounded-xl border border-line shadow-sm">

    <!-- Toolbar -->
    <div class="p-4 border-b border-line flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">

        <div class="relative flex-1 max-w-md">
            <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            <input type="text" id="user-search" placeholder="Search by name, email or branch..."
                   class="w-full rounded-lg border border-line pl-9 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-700/20 focus:border-brand-700" />
        </div>

        <div class="flex flex-wrap items-center gap-1.5">
            <a asp-action="Users" asp-route-filter="all"
               class="px-3 py-1.5 rounded-full text-xs font-medium border transition-colors @(currentFilter == "all" ? "bg-brand-700 text-white border-brand-700" : "bg-white text-ink/70 border-line hover:border-brand-700/40")">
                All (@allUsers.Count)
            </a>
            <a asp-action="Users" asp-route-filter="admin"
               class="px-3 py-1.5 rounded-full text-xs font-medium border transition-colors @(currentFilter == "admin" ? "bg-brand-700 text-white border-brand-700" : "bg-white text-ink/70 border-line hover:border-brand-700/40")">
                Admins (@adminCount)
            </a>
            <a asp-action="Users" asp-route-filter="managers"
               class="px-3 py-1.5 rounded-full text-xs font-medium border transition-colors @(currentFilter == "managers" ? "bg-brand-700 text-white border-brand-700" : "bg-white text-ink/70 border-line hover:border-brand-700/40")">
                Managers (@managerCount)
            </a>
            <a asp-action="Users" asp-route-filter="customers"
               class="px-3 py-1.5 rounded-full text-xs font-medium border transition-colors @(currentFilter == "customers" ? "bg-brand-700 text-white border-brand-700" : "bg-white text-ink/70 border-line hover:border-brand-700/40")">
                Customers (@customerCount)
            </a>
            <a asp-action="Users" asp-route-filter="inactive"
               class="px-3 py-1.5 rounded-full text-xs font-medium border transition-colors @(currentFilter == "inactive" ? "bg-brand-700 text-white border-brand-700" : "bg-white text-ink/70 border-line hover:border-brand-700/40")">
                Inactive (@inactiveCount)
            </a>
        </div>
    </div>

    @if (!users.Any())
    {
        <div class="py-16 text-center">
            <svg class="w-12 h-12 mx-auto text-muted/50 mb-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
            <h3 class="text-base font-semibold text-ink">No users here</h3>
            <p class="text-sm text-muted mt-1">Add your first account to get started.</p>
            <a href="/Admin/CreateUser"
               class="inline-flex items-center gap-2 mt-5 px-4 py-2 rounded-lg bg-brand-700 text-white text-sm font-semibold hover:bg-brand-800">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
                Add user
            </a>
        </div>
    }
    else
    {
        <!-- Table (desktop) -->
        <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-surface text-muted text-xs uppercase tracking-wide">
                    <tr>
                        <th class="text-left font-medium px-4 py-3">User</th>
                        <th class="text-left font-medium px-4 py-3">Role</th>
                        <th class="text-left font-medium px-4 py-3 w-32">Branch</th>
                        <th class="text-left font-medium px-4 py-3 w-28">Status</th>
                        <th class="text-right font-medium px-4 py-3 w-32">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line">
                    @foreach (var u in users)
                    {
                        <tr class="hover:bg-surface/60 transition-colors user-row"
                            data-search="@($"{u.FullName} {u.Email} {u.Branch ?? ""} {u.Role}".ToLower())">
                            <td class="px-4 py-3">
                                <div class="font-medium text-ink leading-tight">@u.FullName</div>
                                <div class="text-xs text-muted">@u.Email</div>
                            </td>
                            <td class="px-4 py-3">
                                @if (u.Role == "Admin")
                                {
                                    <span class="inline-block px-2 py-0.5 rounded-full text-[0.7rem] font-semibold bg-accent/10 text-accent">@u.Role</span>
                                }
                                else if (u.Role.StartsWith("Manager"))
                                {
                                    <span class="inline-block px-2 py-0.5 rounded-full text-[0.7rem] font-semibold bg-brand-700/10 text-brand-700">@u.Role</span>
                                }
                                else
                                {
                                    <span class="inline-block px-2 py-0.5 rounded-full text-[0.7rem] font-semibold bg-surface text-muted">@u.Role</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-ink/75">
                                @(string.IsNullOrWhiteSpace(u.Branch) ? "—" : u.Branch)
                            </td>
                            <td class="px-4 py-3">
                                @if (u.Active)
                                {
                                    <span class="inline-flex items-center gap-1.5 text-xs font-medium text-success">
                                        <span class="w-1.5 h-1.5 rounded-full bg-success"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 text-xs font-medium text-muted">
                                        <span class="w-1.5 h-1.5 rounded-full bg-muted"></span> Inactive
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex items-center justify-end gap-1">
                                    <a asp-action="EditUser" asp-route-id="@u.Id"
                                       class="p-2 rounded-lg text-muted hover:bg-surface hover:text-brand-700" title="Edit">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                    </a>
                                    <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post" class="inline"
                                          data-confirm="Delete @u.FullName's account? They will lose access immediately."
                                          data-confirm-title="Delete user"
                                          data-confirm-ok="Delete">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="p-2 rounded-lg text-muted hover:bg-danger/10 hover:text-danger" title="Delete">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile cards -->
        <div class="md:hidden divide-y divide-line">
            @foreach (var u in users)
            {
                <div class="p-4">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <div class="font-medium text-ink">@u.FullName</div>
                            <div class="text-xs text-muted truncate">@u.Email</div>
                            <div class="text-xs text-muted mt-0.5">@u.Role@(!string.IsNullOrWhiteSpace(u.Branch) ? $" · {u.Branch}" : "")</div>
                        </div>
                        @if (u.Active)
                        {
                            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-success shrink-0">
                                <span class="w-1.5 h-1.5 rounded-full bg-success"></span> Active
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-muted shrink-0">
                                <span class="w-1.5 h-1.5 rounded-full bg-muted"></span> Inactive
                            </span>
                        }
                    </div>
                    <div class="flex gap-1 mt-3">
                        <a asp-action="EditUser" asp-route-id="@u.Id"
                           class="px-3 py-1 rounded-md text-xs font-medium border border-line hover:bg-surface">Edit</a>
                        <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post"
                              data-confirm="Delete @u.FullName's account?"
                              data-confirm-title="Delete user">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="px-3 py-1 rounded-md text-xs font-medium border border-danger/30 text-danger hover:bg-danger/5">Delete</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('user-search');
            if (!input) return;
            var rows = document.querySelectorAll('.user-row');

            input.addEventListener('input', function () {
                var q = this.value.trim().toLowerCase();
                rows.forEach(function (row) {
                    var haystack = row.dataset.search || '';
                    row.style.display = !q || haystack.indexOf(q) !== -1 ? '' : 'none';
                });
            });
        })();
    </script>
}